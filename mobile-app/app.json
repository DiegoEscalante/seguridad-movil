{
  "expo": {
    "name": "UniSabana Seguridad Móvil",
    "slug": "unisabana-seguridad-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.edu.unisabana.seguridad"
    },
    "android": {
      "package": "co.edu.unisabana.seguridad"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite el acceso a la cámara para escanear códigos QR de configuración TOTP (otpauth://)."
        }
      ]
    ]
  }
}